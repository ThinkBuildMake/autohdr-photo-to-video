# Copy to .env for local runs. Never commit .env.
# In the cloud session or on Railway, set these as environment variables instead.

# --- OpenRouter (video, image and vision calls) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Video models (ids from GET $OPENROUTER_BASE_URL/videos/models)
VIDEO_MODEL=google/veo-3.1
VIDEO_MODEL_FALLBACK=bytedance/seedance-2.0
# Resolution per model, comma separated model=resolution
VIDEO_RESOLUTIONS=google/veo-3.1=1080p,bytedance/seedance-2.0=1080p

# Photo edit and quality check models
ENHANCE_MODEL=google/gemini-nano-banana-2.1
ENHANCE_MODEL_FALLBACK=google/gemini-3.1-flash-image
QUALITY_CHECK_MODEL=google/gemini-3.8-flash

# Models billed to your own key through OpenRouter BYOK (cost recorded at list price)
BYOK_MODELS=google/veo-3.1

# --- Pipeline settings ---
SHOTS_IN_FLIGHT=8
CHECK_FRAMES_PER_SECOND=6
CHECK_MAX_AI_SCORE=0.5
CHECK_MIN_MATCH_SCORE=0.5
LABEL_IMAGE_LONG_SIDE=768

# --- Storage: Railway Storage Bucket (S3 API) ---
BUCKET_ENDPOINT=https://storage.railway.app
BUCKET_NAME=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_REGION=auto

# --- App ---
DATABASE_PATH=./data/app.db
DEMO_PASSPHRASE=
PORT=8000

# Tests and local runs without spending money
FAKE_PROVIDERS=0

# --- Research scripts only (tools/) ---
TEST_PHOTOS_URL=
MAX_CLIPS_PER_RUN=6
