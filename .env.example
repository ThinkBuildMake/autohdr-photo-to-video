# Copy to .env for local runs. Never commit .env.
# In the cloud session, set these in the environment settings instead
# (Network secrets, or environment variables), then start a new session.

# --- Needed now: video research (docs/VIDEO_RESEARCH.md) ---

# OpenRouter key for video, image and vision calls. Create it with a spend cap.
OPENROUTER_API_KEY=

# Base URL for the OpenRouter API. Leave the default unless proxying.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Where the 12 PRD test photoshoots are downloaded from (the Dropbox link in
# docs/AutoHDR Photo to Video.pdf). Folder URL, not a file.
TEST_PHOTOS_URL=

# Models under test. Ids come from GET $OPENROUTER_BASE_URL/videos/models.
VIDEO_MODEL_A=bytedance/seedance-2.0
VIDEO_MODEL_B=google/veo-3.1

# Smoke-test limits so a mistaken run cannot spend much.
MAX_CLIPS_PER_RUN=6
CLIP_SECONDS=5
RESOLUTION=720p

# --- Needed later: the app (HIGH_LEVEL_DESIGN.md), uncomment when built ---

# Photo enhancement and quality-check models (same OpenRouter key).
# ENHANCE_MODEL=
# QUALITY_CHECK_MODEL=

# File storage for photos, clips and videos (HLD file storage). Local path for the demo.
# STORAGE_DIR=./data

# Database for styles, jobs, shots and attempts (HLD database).
# DATABASE_URL=

# App server.
# PORT=3000
